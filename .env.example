# 复制为 .env 后即可使用：cp .env.example .env
# 演示运行时使用项目根目录下的 SQLite 文件库，无需 Docker、PostgreSQL 或 pgvector。
DATABASE_URL=sqlite:///./demo.db

# 演示环境专用。部署到服务器必须换成随机值，并启用 COOKIE_SECURE。
SESSION_SECRET=demo-only-local-secret-change-me-0123456789
ENVIRONMENT=development
DEMO_PASSWORD=Demo-Only-2026!
COOKIE_SECURE=false

# mock 使用确定性检索结果拼接草稿，不调用模型；live 才访问真实模型接口。
# 未配置 embedding 时仅使用 BM25，不会伪造向量。
AI_MODE=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=30

EMBEDDING_ENABLED=false
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1536
EMBEDDING_TIMEOUT=20

NEWS_MODE=replay
SEND_MODE=manual
APP_PORT=8000

# 生产或容器部署时改回 PostgreSQL + pgvector（需 Docker Compose 与 migrate 重建索引）：
# DATABASE_URL=postgresql+psycopg://copilot:copilot@db:5432/copilot
